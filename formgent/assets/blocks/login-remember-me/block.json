{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "formgent/login-remember-me",
  "title": "Login Remember Me",
  "category": "formgent",
  "description": "Remember Me checkbox for the login block.",
  "textdomain": "formgent",
  "parent": [
    "formgent/login"
  ],
  "attributes": {
    "id": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": "login_remember"
    },
    "label": {
      "type": "string",
      "default": "Remember Me"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "block_width": {
      "type": "string",
      "default": "50"
    },
    "is_preview": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "inserter": false,
    "interactivity": true
  },
  "editorScript": "file:index.js",
  "style": "file:style-index.css",
  "editorStyle": "file:index.css",
  "render": "file:render.php"
}